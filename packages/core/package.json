{
  "name": "@redactenv/core",
  "version": "0.2.0",
  "description": "Detection + redaction engine for API keys and secrets in outgoing data",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "keywords": ["security", "redact", "secrets", "api-keys", "leak"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsyaba/redactenv.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/itsyaba/redactenv/issues",
  "homepage": "https://github.com/itsyaba/redactenv#readme",
  "publishConfig": {
    "access": "public"
  }
}
