{
  "name": "@redactenv/patterns",
  "version": "0.2.0",
  "description": "Curated regex catalog of common secret formats for use with @redactenv/core",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@redactenv/core": "0.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsyaba/redactenv.git",
    "directory": "packages/patterns"
  },
  "bugs": "https://github.com/itsyaba/redactenv/issues",
  "homepage": "https://github.com/itsyaba/redactenv#readme",
  "publishConfig": {
    "access": "public"
  }
}
