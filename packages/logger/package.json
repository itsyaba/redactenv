{
  "name": "@redactenv/logger",
  "version": "0.2.0",
  "description": "Logger adapters: pino transport + console patcher that redact secrets",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./console": {
      "import": {
        "types": "./dist/console.d.ts",
        "default": "./dist/console.js"
      },
      "require": {
        "types": "./dist/console.d.cts",
        "default": "./dist/console.cjs"
      }
    },
    "./pino": {
      "import": {
        "types": "./dist/pino.d.ts",
        "default": "./dist/pino.js"
      },
      "require": {
        "types": "./dist/pino.d.cts",
        "default": "./dist/pino.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@redactenv/core": "0.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsyaba/redactenv.git",
    "directory": "packages/logger"
  },
  "bugs": "https://github.com/itsyaba/redactenv/issues",
  "homepage": "https://github.com/itsyaba/redactenv#readme",
  "publishConfig": {
    "access": "public"
  }
}
